# Bench. needs no .env: the TomFit app registration (public client, device-code flow) is built in.
# Set these only to point at another tenant or registration.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=

# Extra Graph scopes on top of the built-in set (Tasks.ReadWrite, Files.ReadWrite; Sites.Read.All and
# Calendars.Read as a second, admin-approved tier). Rarely needed.
# GRAPH_SCOPES=

# Minutes between polls of the connected tools while the app is running (default 2). Port for `npm start` (default 5178).
# SYNC_INTERVAL_MINUTES=2
# PORT=5178

# Time clock target in your OneDrive. Default: Documents/TomFit_Zeiterfassung_{year}_{name}.xlsx
# TIMESHEET_PATH=
# TIMESHEET_URL=
