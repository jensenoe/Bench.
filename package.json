{
  "name": "bench",
  "private": true,
  "version": "0.9.0-beta.6",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "setup": "node server/setup.js",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "test": "vitest run",
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "photos:bat": "node scripts/gen-fetch.mjs",
    "test:ui": "node tests/ui/smoke.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^4.21.2",
    "motion": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  },
  "productName": "Bench",
  "description": "Local project board for TomFit bench work",
  "author": "Noël Jensen <noel@tom.fit>",
  "main": "electron/main.cjs",
  "build": {
    "appId": "fit.tom.bench",
    "productName": "Bench",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Bench-portable-${version}.exe"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Bench-Setup-${version}.exe",
      "shortcutName": "Bench.",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/LICENSE.txt",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "uninstallDisplayName": "Bench."
    },
    "extraResources": [
      {
        "from": "build/README-install.txt",
        "to": "README.txt"
      }
    ]
  }
}
